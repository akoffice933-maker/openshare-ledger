# Приватный контрольный набор: в репозитории только его хеши,
# сами примеры не публикуются никогда.
private/golden.jsonl

# Python
__pycache__/
*.pyc
.venv/
venv/

# Локальное
.DS_Store
.idea/
.vscode/
*.swp

# Служебные результаты CI
result.json

# Генерируемые артефакты: восстанавливаются run_demo.sh
demo/repo/
report.html

# state/ НАМЕРЕННО НЕ ИГНОРИРУЕТСЯ.
# Леджер — это продукт, а не артефакт сборки: обещание «публичный и
# воспроизводимый из git» возможно, только если он лежит в git.
# demo/repo пересоздаётся make_demo_repo.py, поэтому его не коммитим.
